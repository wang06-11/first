# ===== Secrets（不提交，复制为 .env 填写）=====
# AI 摘要（可选；不填则降级为原文截取摘要）
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# 推送渠道（全部可选，留空仅生成网页）
# ntfy.sh 免费推送：手机装 ntfy App，订阅该 topic 即可收推送
NTFY_TOPIC=
# Telegram Bot：@BotFather 创建，CHAT_ID 为你的对话 ID
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# 任意 Webhook（如企业微信/飞书/自定义）：POST JSON
WEBHOOK_URL=
